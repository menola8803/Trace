<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="?android:attr/selectableItemBackground"
            android:fontFamily="@font/jakarta_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:text="@string/about_trace"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <ImageView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Trace"
            android:src="@drawable/trace_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/cinzel_bold"
            android:letterSpacing="0.32"
            android:shadowColor="#4DE8B04A"
            android:shadowRadius="18"
            android:text="TRACE"
            android:textColor="@color/gold"
            android:textSize="38sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jakarta_bold"
            android:letterSpacing="0.22"
            android:text="@string/tagline"
            android:textColor="@color/mint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/jakarta_bold"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/Trace.AboutTitle" android:text="@string/about_map_title" />
            <TextView style="@style/Trace.AboutBody" android:text="@string/about_map_body" />

            <TextView style="@style/Trace.AboutTitle" android:layout_marginTop="14dp" android:text="@string/about_antennas_title" />
            <TextView style="@style/Trace.AboutBody" android:text="@string/about_antennas_body" />

            <TextView style="@style/Trace.AboutTitle" android:layout_marginTop="14dp" android:text="@string/about_abnormal_title" />
            <TextView style="@style/Trace.AboutBody" android:text="@string/about_abnormal_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/developer_line"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jakarta_bold"
            android:text="@string/learning_only"
            android:textColor="@color/mint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/aboutSource"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="github.com/menola8803/Trace"
            android:textColor="@color/gold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/attribution"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
