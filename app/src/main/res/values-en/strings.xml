    <string name="about_map_title">Map</string>
    <string name="about_map_body">Every cell the phone hears is saved with time, place and signal strength and drawn on OpenStreetMap, together with known masts from OpenCellID.</string>
    <string name="about_antennas_title">Antennas</string>
    <string name="about_antennas_body">See which cell you are connected to, how strong the signal is and which cells you have heard before.</string>
    <string name="about_abnormal_title">Anomalies</string>
    <string name="about_abnormal_body">Antennas that move, have abnormal strength, are short-lived or are missing from OpenCellID get an exclamation mark. A question mark shows where it happened.</string>
