<?xml version="1.0" encoding="utf-8"?>
<!-- Veckodag i schemat: guld när vald, kontur när inte vald -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval"><solid android:color="@color/gold" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/chip" /><stroke android:width="1dp" android:color="@color/line" /></shape>
    </item>
</selector>
